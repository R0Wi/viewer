  -
  - Runs as part of a full Nextcloud server checkout, like every other app's
  - test suite (see tests/bootstrap.php) — not standalone. Not yet wired up
  - in this repository's CI; see the PR that introduced this file.
  -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
	<testsuites>
		<testsuite name="unit">
			<directory>./tests/Unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">./lib</directory>
		</include>
	</source>
</phpunit>
