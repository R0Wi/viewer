<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    phpVersion="8.3"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorBaseline="tests/psalm-baseline.xml"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
	<stubs>
		<file name="tests/stubs/oca_files_event_loadadditionalscriptevent.php"/>
		<file name="tests/stubs/oca_dav_connector_sabre_file.php"/>
		<file name="tests/stubs/sabre.php"/>
	</stubs>
    <extraFiles>
		<directory name="vendor-bin/psalm/vendor/nextcloud/ocp" />
    </extraFiles>
    <issueHandlers>
        <!-- Not our code: issues inside the OCP api stubs, which are only
             analysed because lib/ extends them (e.g. OCP\AppFramework\Controller) -->
        <MissingClosureReturnType>
            <errorLevel type="suppress">
                <directory name="vendor-bin/psalm/vendor/nextcloud/ocp" />
            </errorLevel>
        </MissingClosureReturnType>
        <MissingClosureParamType>
            <errorLevel type="suppress">
                <directory name="vendor-bin/psalm/vendor/nextcloud/ocp" />
            </errorLevel>
        </MissingClosureParamType>
        <MixedArgument>
            <errorLevel type="suppress">
                <directory name="vendor-bin/psalm/vendor/nextcloud/ocp" />
            </errorLevel>
        </MixedArgument>
        <InvalidTemplateParam>
            <errorLevel type="suppress">
                <directory name="vendor-bin/psalm/vendor/nextcloud/ocp" />
            </errorLevel>
        </InvalidTemplateParam>
    </issueHandlers>
</psalm>
